{
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": ["src"]
}